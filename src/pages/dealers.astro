---
import DealerCatalog from '../components/DealerCatalog.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY } from '../lib/copy';
const copy = COPY.nl;
---
<BaseLayout title={copy.catalogTitle} description={copy.catalogDescription}>
	<section class="page-hero product-hero"><div class="wrap"><p class="eyebrow">40 verkooppunten</p><h1>{copy.catalogTitle}</h1><p>{copy.catalogDescription}</p></div></section>
	<section class="section wrap" aria-labelledby="catalogustitel"><h2 id="catalogustitel">Zoek op regio, type of postcode</h2><DealerCatalog locale="nl" /></section>
</BaseLayout>
