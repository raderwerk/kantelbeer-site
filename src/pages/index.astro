---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY } from '../lib/copy';

const copy = COPY.nl;
const dealersHref = `${import.meta.env.BASE_URL}dealers`;
---

<BaseLayout locale="nl" title={copy.homeTitle} description={copy.homeDescription}>
	<h1>{copy.homeTitle}</h1>
	<p>{copy.homeDescription}</p>
	<p class="lead">{copy.homeLead}</p>
	<p><a href={dealersHref}>{copy.homeCta}</a></p>
</BaseLayout>
