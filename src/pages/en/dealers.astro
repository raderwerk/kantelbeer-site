---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealerCatalog from '../../components/DealerCatalog.astro';
import { COPY } from '../../lib/copy';

const copy = COPY.en;
---

<BaseLayout locale="en" title={`${copy.catalogTitle} — Kantelbeer`} description={copy.catalogDescription}>
	<h1>{copy.catalogTitle}</h1>
	<p>{copy.catalogDescription}</p>
	<DealerCatalog locale="en" />
</BaseLayout>
