---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COPY } from '../../lib/copy';

const copy = COPY.en;
const dealersHref = `${import.meta.env.BASE_URL}en/dealers`;
---

<BaseLayout locale="en" title={copy.homeTitle} description={copy.homeDescription}>
	<h1>{copy.homeTitle}</h1>
	<p>{copy.homeDescription}</p>
	<p class="lead">{copy.homeLead}</p>
	<p><a href={dealersHref}>{copy.homeCta}</a></p>
</BaseLayout>
