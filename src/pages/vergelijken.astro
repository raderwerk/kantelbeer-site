---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecificationTable from '../components/SpecificationTable.astro';
import { products } from '../data/products';
const productSlugs = products.map(product => product.slug);
---
<BaseLayout title="Systemen vergelijken" description="Vergelijk maximaal drie Kantelbeer-systemen naast elkaar.">
	<section class="page-hero"><div class="wrap"><p class="eyebrow">Vergelijker</p><h1>Leg specificaties naast elkaar.</h1><p>Kies maximaal drie systemen. De selectie staat in de URL, zodat je de vergelijking kunt delen.</p></div></section>
	<section class="section wrap compare" data-compare>
		<fieldset><legend>Kies systemen</legend><div class="compare-options">{products.map(product => <label><input type="checkbox" value={product.slug} /> <span><strong>{product.name}</strong><small>{product.summary}</small></span></label>)}</div></fieldset>
		<p class="compare-status" role="status" aria-live="polite">Kies één tot drie systemen.</p>
		<div class="compare-table"><SpecificationTable products={products} caption="Vergelijking productspecificaties" /></div>
	</section>
	<script is:inline define:vars={{ productSlugs }}>
		const root = document.querySelector('[data-compare]');
		const checks = [...root.querySelectorAll('input[type="checkbox"]')];
		const table = root.querySelector('table');
		const status = root.querySelector('[role="status"]');
		const validSlugs = new Set(productSlugs);
		const initial = [...new Set((new URLSearchParams(location.search).get('producten') || '').split(',').filter(slug => validSlugs.has(slug)))].slice(0, 3);
		checks.forEach(check => { check.checked = initial.includes(check.value); });
		function render(updateUrl = true) {
			const selected = checks.filter(check => check.checked).map(check => check.value).slice(0, 3);
			checks.forEach(check => { check.disabled = selected.length >= 3 && !check.checked; });
			const visible = productSlugs.map((slug, index) => ({ slug, index: index + 1 })).filter(({ slug }) => selected.includes(slug));
			table.querySelectorAll('tr').forEach(row => {
				[...row.children].slice(1).forEach((cell, index) => { cell.hidden = !visible.some(item => item.index === index + 1); });
			});
			status.textContent = selected.length ? `${selected.length} van maximaal 3 systemen geselecteerd.` : 'Kies één tot drie systemen.';
			if (updateUrl) { const url = new URL(location.href); selected.length ? url.searchParams.set('producten', selected.join(',')) : url.searchParams.delete('producten'); history.replaceState({}, '', url); }
		}
		checks.forEach(check => check.addEventListener('change', () => render()));
		render();
	</script>
</BaseLayout>
