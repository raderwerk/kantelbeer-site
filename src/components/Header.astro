---
import { nav } from '../data/site';
import type { Locale } from '../lib/labels';
interface Props { locale?: Locale; }
const { locale = 'nl' } = Astro.props;
const english = locale === 'en';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const url = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
---
<header class="site-header">
	<div class="utility wrap"><span>{english ? 'Hydraulic systems for professionals' : 'Hydraulische systemen voor professionals'}</span><a href={url(english ? '/' : '/en/')} hreflang={english ? 'nl' : 'en'}>{english ? 'NL' : 'EN'}</a></div>
	<div class="navigation wrap">
		<a class="brand" href={url(english ? '/en/' : '/')} aria-label={english ? 'Kantelbeer, go home' : 'Kantelbeer, naar home'}><span class="brand-mark" aria-hidden="true"><i></i><i></i></span><strong>KANTELBEER</strong></a>
		<nav aria-label="Hoofdnavigatie">
			<ul>
				{nav.map((item) => <li class="nav-item">
					<a href={item.href === '/producten' ? url('/#systemen') : url(item.href)} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
					{'children' in item && <ul class="dropdown">{item.children.map(child => <li><a href={url(child.href)}>{child.label}</a></li>)}</ul>}
				</li>)}
			</ul>
		</nav>
		<details class="mobile-menu">
			<summary>Menu</summary>
			<nav aria-label="Mobiele hoofdnavigatie">
				<ul>
					{nav.map((item) => <li>
						<a href={item.href === '/producten' ? url('/#systemen') : url(item.href)} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
						{'children' in item && <ul>{item.children.map(child => <li><a href={url(child.href)}>{child.label}</a></li>)}</ul>}
					</li>)}
				</ul>
			</nav>
		</details>
		<a class="dealer-link" href={url(english ? '/en/dealers' : '/dealerzoeker')}>{english ? 'Find a dealer' : 'Vind een dealer'} <span aria-hidden="true">↗</span></a>
	</div>
</header>
