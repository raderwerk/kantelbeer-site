---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Locale } from '../lib/labels';
import { COPY } from '../lib/copy';
interface Props { title: string; description: string; locale?: Locale; }
const { title, description, locale = 'nl' } = Astro.props;
const copy = COPY[locale];
---
<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<title>{title} · Kantelbeer</title>
	</head>
	<body>
		<a class="skip-link" href="#inhoud">{copy.skip}</a>
		<Header locale={locale} />
		<main id="inhoud"><slot /></main>
		<Footer locale={locale} />
	</body>
</html>
