---
import { COPY, DISCLAIMER } from '../lib/copy';
import type { Locale } from '../lib/labels';

interface Props {
	locale: Locale;
	title: string;
	description: string;
}

const localeHome: Record<Locale, string> = {
	nl: '',
	en: 'en/',
};

const localeDealers: Record<Locale, string> = {
	nl: 'dealers',
	en: 'en/dealers',
};

const otherLocale: Record<Locale, Locale> = {
	nl: 'en',
	en: 'nl',
};

function withBase(path: string): string {
	const base = import.meta.env.BASE_URL;
	if (!path) return base;
	return `${base}${path}`;
}

const { locale, title, description } = Astro.props;
const copy = COPY[locale];
const other = otherLocale[locale];
const otherCopy = COPY[other];
const homeHref = withBase(localeHome[locale]);
const dealersHref = withBase(localeDealers[locale]);
const otherHomeHref = withBase(localeHome[other]);
const otherDealersHref = withBase(localeDealers[other]);
const isDealers = Astro.url.pathname.includes('dealers');
const langSwitchBase = isDealers ? otherDealersHref : otherHomeHref;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#inhoud">{copy.skip}</a>
		<header class="site-header">
			<p class="wordmark"><a href={homeHref}>Kantelbeer</a></p>
			<nav aria-label={copy.mainNav}>
				<ul class="nav-list">
					<li><a href={homeHref} aria-current={isDealers ? undefined : 'page'}>{copy.home}</a></li>
					<li>
						<a href={dealersHref} aria-current={isDealers ? 'page' : undefined}>{copy.dealersNav}</a>
					</li>
				</ul>
			</nav>
			<nav class="lang-switch" aria-label={copy.language}>
				<a
					href={langSwitchBase}
					hreflang={other}
					lang={other}
					data-lang-switch
					data-lang-base={langSwitchBase}
				>
					{otherCopy.languageName}
				</a>
			</nav>
		</header>
		<main id="inhoud">
			<slot />
		</main>
		<footer>
			<p lang="nl">{DISCLAIMER}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--text: #1a1a1a;
		--muted: #3d4654;
		--bg: #ffffff;
		--surface: #f3f5f8;
		--border: #c5ccd6;
		--link: #0a4b8c;
		--link-hover: #083a6d;
		--focus: #0a4b8c;
		--empty: #eef2f6;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: system-ui, sans-serif;
		line-height: 1.5;
		margin: 0 auto;
		max-width: 72rem;
		padding: 1.25rem 1.25rem 4rem;
		color: var(--text);
		background: var(--bg);
	}

	:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 3px;
	}

	.skip-link {
		position: absolute;
		left: 0.75rem;
		top: -40rem;
		z-index: 10;
		background: var(--bg);
		color: var(--link);
		padding: 0.5rem 0.75rem;
		font-weight: 600;
	}

	.skip-link:focus {
		top: 0.75rem;
	}

	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.wordmark {
		font-weight: 700;
		letter-spacing: 0.02em;
		margin: 0;
		margin-right: auto;
	}

	.wordmark a,
	nav a {
		color: var(--link);
		text-decoration: none;
	}

	.wordmark a:hover,
	nav a:hover {
		color: var(--link-hover);
		text-decoration: underline;
	}

	.nav-list {
		display: flex;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lang-switch a {
		font-weight: 600;
	}

	main h1 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}

	.lead {
		max-width: 46rem;
		color: var(--muted);
	}

	a {
		color: var(--link);
	}

	a:hover {
		color: var(--link-hover);
	}

	footer {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		font-size: 0.875rem;
		color: var(--muted);
	}

	.catalog-form {
		background: var(--surface);
		border: 1px solid var(--border);
		padding: 1rem;
		margin: 1.5rem 0;
	}

	.catalog-form fieldset {
		border: 0;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}

	.catalog-form legend {
		font-weight: 700;
		margin-bottom: 0.75rem;
	}

	.field {
		display: grid;
		gap: 0.35rem;
	}

	.field label {
		font-weight: 600;
	}

	.field .hint {
		color: var(--muted);
		font-size: 0.9rem;
	}

	input,
	select,
	button {
		font: inherit;
		color: var(--text);
	}

	input,
	select {
		width: 100%;
		max-width: 28rem;
		min-height: 2.75rem;
		padding: 0.4rem 0.6rem;
		border: 1px solid #6b7380;
		background: var(--bg);
		border-radius: 0.25rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.4rem;
	}

	button {
		min-height: 2.75rem;
		padding: 0.45rem 0.9rem;
		border-radius: 0.25rem;
		border: 2px solid var(--link);
		background: var(--link);
		color: #fff;
		font-weight: 600;
		cursor: pointer;
	}

	button[type='reset'] {
		background: var(--bg);
		color: var(--link);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.catalog-status {
		font-weight: 600;
		margin: 1.25rem 0 0.75rem;
	}

	.dealer-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
	}

	.dealer-card {
		border: 1px solid var(--border);
		padding: 1rem 1.1rem;
		background: var(--bg);
		height: 100%;
	}

	.dealer-card h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}

	.dealer-card__type,
	.dealer-card__distance {
		margin: 0 0 0.35rem;
		color: var(--muted);
	}

	.dealer-card__address {
		font-style: normal;
		margin: 0 0 0.75rem;
	}

	.empty-state {
		background: var(--empty);
		border: 1px solid var(--border);
		padding: 1.1rem 1.2rem;
	}

	.empty-state h3 {
		margin: 0 0 0.75rem;
		font-size: 1.1rem;
	}

	.empty-state__alts {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.45rem;
	}

	@media (min-width: 768px) {
		.catalog-form fieldset {
			grid-template-columns: 1fr 1fr;
		}

		.dealer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 1440px) {
		body {
			padding-left: 2rem;
			padding-right: 2rem;
		}

		.dealer-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}
</style>
